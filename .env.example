# Cesty k binárkám (výchozí hodnoty předpokládají, že jsou v PATH).
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Vygenerováno pomocí `npm run setup:whisper` — viz výstup skriptu.
WHISPER_CPP_BIN=vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=models/ggml-base.bin

# Kam se ukládají dočasné soubory jednotlivých úloh (stažené video, zvuk,
# titulky, výsledný klip). Výchozí hodnota je adresář ve $TMPDIR.
STRIHAI_WORK_DIR=
